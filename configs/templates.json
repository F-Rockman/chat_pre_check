          "extractors": [
            {
              "type": "keyword_value",
              "cases": [
                {"terms": ["错误包", "错包"], "value": "error_packet"}
              ]
            }
          ]
        },
        "query_operator": {
          "extractors": [
            {
              "type": "keyword_value",
              "cases": [
                {"terms": ["top", "前", "排名", "排行"], "value": "topn"}
              ]
            }
          ]
        }
      },
      "llm_slot_extraction": {
        "enabled": true,
        "slots": ["time_range", "topn", "region_id"],
        "instructions": "仅补充接口错误包告警排行模板中的时间、区域和TopN参数。"
      },
