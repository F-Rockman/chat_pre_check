{
  "search_backend": "opensearch",
  "model_name": "intfloat/multilingual-e5-base",
  "device": "cpu",
  "scene_index": "scene_vector_v1",
  "template_index": "template_vector_v1",
  "seed_case_index": "seed_case_v1",
  "device_index": "assets_device_v1",
  "region_index": "assets_region_v1",
  "scene_topk": 5,
  "template_topk": 5,
  "seed_case_topk": 5,
  "default_timezone": "Asia/Shanghai",
  "fusion_weights": {
    "scene": {
      "rule": 0.35,
      "vector": 0.45,
      "entity": 0.20
    },
    "template": {
      "rule": 0.30,
      "vector": 0.50,
      "slot_fit": 0.20
    }
  },
  "seed_scope_guard": {
    "enabled": false,
    "min_score": 0.58,
    "min_hits": 1,
    "topk": 5,
    "allowed_scenes": []
  },
  "param_prefill": {
    "enabled": false,
    "dictionary_file": "ac_terms.json",
    "auto_commit": true,
    "commit_score": 0.95,
    "min_gap": 0.05,
    "max_candidates_per_slot": 3,
    "ignore_case": true,
    "default_word_boundary": true,
    "min_term_length": 2,
    "max_matches": 200,
    "skip_remote_resolver_when_prefilled": true
  },
  "reindex_on_start": false
}
