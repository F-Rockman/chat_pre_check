{
  "search_backend": "opensearch",
  "embedding": {
    "provider": "sentence_transformers",
    "model": "intfloat/multilingual-e5-base",
    "device": "cpu",
    "dimension": 768,
    "query_prefix": "query: ",
    "passage_prefix": "passage: ",
    "normalize_embeddings": true
  },
  "model_name": "intfloat/multilingual-e5-base",
  "device": "cpu",
  "scene_index": "scene_vector_v1",
  "template_index": "template_vector_v1",
  "seed_case_index": "seed_case_v1",
  "device_index": "assets_device_v1",
  "region_index": "assets_region_v1",
  "scene_topk": 5,
  "template_topk": 5,
  "seed_case_topk": 5,
  "default_timezone": "Asia/Shanghai",
  "fusion_weights": {
    "scene": {
      "rule": 0.35,
      "vector": 0.45,
      "entity": 0.20
    },
    "template": {
      "rule": 0.30,
      "vector": 0.50,
      "slot_fit": 0.20
    }
  },
  "seed_scope_guard": {
    "enabled": false,
    "min_score": 0.58,
    "min_hits": 1,
    "topk": 5,
    "allowed_scenes": []
  },
  "param_prefill": {
    "enabled": false,
    "dictionary_file": "ac_terms.json",
    "auto_commit": true,
    "commit_score": 0.95,
    "min_gap": 0.05,
    "max_candidates_per_slot": 3,
    "ignore_case": true,
    "default_word_boundary": true,
    "min_term_length": 2,
    "max_matches": 200,
    "domain_penalty": 0.2,
    "domain_priority": {
      "device": 1.0,
      "region": 0.9,
      "alarm": 0.7,
      "kpi": 0.8,
      "default": 0.5
    },
    "slot_domain_priority": {
      "device_id": ["device"],
      "region_id": ["region"],
      "metric": ["kpi", "alarm"],
      "severity": ["alarm"],
      "alarm_status": ["alarm"]
    },
    "domain_router": {
      "enabled": true,
      "max_domains": 2,
      "default_domains": ["device", "region", "alarm", "kpi"],
      "scene_domains": {
        "alarm.query": ["alarm", "region"],
        "device.query": ["device", "region"],
        "alarm.analysis": ["kpi", "alarm"],
        "ticket.analysis": ["alarm", "region"]
      },
      "keyword_domains": {
        "device": ["设备", "主机", "ip", "hostname"],
        "region": ["区域", "地市", "华东", "华南", "华北", "北京", "广州", "上海", "深圳"],
        "alarm": ["告警", "报警", "严重", "恢复", "未恢复"],
        "kpi": ["kpi", "指标", "cpu", "内存", "带宽", "时延", "抖动", "丢包", "吞吐"]
      },
      "slot_domains": {
        "device_id": ["device"],
        "region_id": ["region"],
        "metric": ["kpi"],
        "severity": ["alarm"]
      }
    },
    "skip_remote_resolver_when_prefilled": true
  },
  "reindex_on_start": false
}
